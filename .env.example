# Environment variable template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and set values there for local
# development. `.env` is for local secrets only and must not be committed.
# This `.env.example` file is safe to commit: it documents names and optional
# defaults without real credentials.
# -----------------------------------------------------------------------------

# Optional — not required for the core pipeline (Phase 4 uses Groq).
OPENAI_API_KEY=

# Required for Phase 4 live Groq LLM calls. Leave unset if you only use offline
# fallback (e.g. recommend_cli --no-llm).
GROQ_API_KEY=

# Optional — Groq chat model id. If unset, the app default is llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — Hugging Face API token for dataset access when needed.
HF_TOKEN=
